# ---- Supabase (wajib) ----
# Buat project sendiri, jalankan supabase/schema.sql di SQL Editor, lalu isi ketiganya.
# Auth, data, dan admin semuanya lewat Supabase. Admin pertama: npm run admin -- email@kamu.id kata-sandi
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Rahasia server ----
# Kunci OpenAI HANYA di sini. Ekstensi tidak pernah memegangnya.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# URL publik situs (untuk link di email/ekstensi)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
