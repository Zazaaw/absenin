# ---- Mode data ----
# Kosongkan SUPABASE_* untuk mode lokal (data di web/.data/db.json, cocok buat testing).
# Isi ketiganya untuk mode Supabase (buat project sendiri, jalankan supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Rahasia server ----
# Kunci OpenAI HANYA di sini. Ekstensi tidak pernah memegangnya.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Dipakai untuk menandatangani cookie sesi (mode lokal) dan kode lisensi. Ganti dengan string acak panjang.
APP_SECRET=ganti-dengan-string-acak-panjang

# Akun admin pertama (mode lokal). Di mode Supabase, set role = 'admin' di tabel profiles.
ADMIN_EMAIL=admin@absenin.local
ADMIN_PASSWORD=admin123

# URL publik situs (untuk link di email/ekstensi)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
